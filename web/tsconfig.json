{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "lib": ["dom", "dom.iterable", "es2019"],
    "strict": true,
    "strictFunctionTypes": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
