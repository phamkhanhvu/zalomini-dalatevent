{
  "appId": "vn.sensegroup.dalatevent",
  "appName": "DalatEvent",
  "webDir": "../web/dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F4F6F8"
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#D24A1C"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com"
      ]
    }
  }
}
