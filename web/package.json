{
  "name": "dalatevent-web",
  "private": true,
  "version": "1.0.0",
  "description": "DalatEvent – website tĩnh độc lập (không dùng WordPress), cũng là phần giao diện của app iOS",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "npm run sync-data && vite",
