    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/agenda.test.ts tests/geo.test.ts tests/search.test.ts tests/itinerary.test.ts tests/sync.test.ts tests/changes.test.ts tests/places.test.ts tests/cms.test.ts tests/passport.test.ts"
  },
  "dependencies": {
    "@capacitor/app-launcher": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource/be-vietnam-pro": "^5.0.0",
    "@fontsource/playfair-display": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "firebase": "^10.14.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
