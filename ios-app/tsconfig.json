{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "lib": ["dom", "dom.iterable", "es2019"],
    "strict": true,
    "strictFunctionTypes": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "zmp-ui": ["src/shims/zmp-ui.tsx"],
      "zmp-sdk": ["src/shims/zmp-sdk.ts"],
      "@shared/*": ["../src/*"],
      "react": ["node_modules/@types/react"],
      "react-router": ["node_modules/react-router"],
      "react/*": ["node_modules/@types/react/*"]
    }
  },
  "include": ["src", "../src/global.d.ts", "../src/components", "../src/pages", "../src/utils", "../src/data"]
}
